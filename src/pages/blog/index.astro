---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const fmt = (d?: Date) => d?.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Writing · Jinang Vohera" description="Notes on search, infrastructure and fundamentals by Jinang Vohera.">
  <main class="page" id="main">
    <p class="crumb mono"><a class="ulink" href={home}>← Home</a></p>
    <h1 class="page-title">Writing</h1>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a class="post" href={`${home}blog/${p.id}/`} target="_blank" rel="noopener">
            <span class="post__date mono">{fmt(p.data.date) ?? 'Undated'}</span>
            <span class="post__body">
              <span class="post__title">{p.data.title}</span>
              <span class="post__desc muted">{p.data.description}</span>
            </span>
            <span class="post__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
