---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BrokeNoMore from '../components/diagrams/BrokeNoMore.astro';
import Cardiology from '../components/diagrams/Cardiology.astro';
import MiniGPT from '../components/diagrams/MiniGPT.astro';
import {
  profile, socials, typewriterLines, experience, education, achievements,
  ratings, projects, earlierProjects, quotes,
} from '../data/site';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const fmt = (d?: Date) => d?.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const diagrams = { brokenomore: BrokeNoMore, cardiology: Cardiology, minigpt: MiniGPT };
---
<Base
  title="Jinang Vohera · Software Engineer"
  description="Jinang Vohera is a software engineer (SDE 2 at DevX) building commerce platforms, cloud pipelines and small LLM experiments."
>
  <script is:inline define:vars={{ typewriterLines }}>window.__lines = typewriterLines;</script>

  <main class="page" id="main">

    <!-- Hero -->
    <section class="hero" aria-label="Introduction">
      <p class="hero__meta">
        <span id="emoji" aria-hidden="true">👋</span>
        <span id="greeting">Hello</span>
        <span class="sep" aria-hidden="true">/</span>
        <time id="clock" aria-hidden="true">--/--/---- --:--:--</time>
        <span class="muted">IST · Ahmedabad, India</span>
      </p>

      <h1 class="pixel-text" id="name" aria-label={profile.name}>{profile.name}</h1>

      <div class="hero__row">
        <div class="hero__copy">
          <p class="hero__role">
            {profile.role}<span class="muted"> · </span><span class="typewriter" id="typewriter">{typewriterLines[0]}</span>
          </p>

          <div class="bio" id="about">
            <p>
              <span class="greet">Hello</span>, I'm Jinang, a software engineer who likes turning messy,
              real-world problems into systems that stay reliable. I work across the stack, from APIs and data
              pipelines to the interfaces people actually touch, and I care about the unglamorous parts: tests,
              observability and clean failure modes.
            </p>
          </div>
        </div>

        <figure class="portrait">
          <img src={`${home}portrait.svg`} alt="Line-art portrait of Jinang Vohera, smiling, with glasses" width="150" height="178">
        </figure>
      </div>

      <div class="socials">
        <ul class="tiles">
          {socials.map((s) => (
            <li>
              <a class="tile" href={s.href} target="_blank" rel="noopener" aria-label={s.label} data-tip={s.label}>
                {s.id === 'github' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a10.9 10.9 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>}
                {s.id === 'linkedin' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>}
                {s.id === 'mail' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>}
                {s.id === 'codeforces' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 7.5C5.328 7.5 6 8.172 6 9v10.5c0 .828-.672 1.5-1.5 1.5h-3C.673 21 0 20.328 0 19.5V9c0-.828.673-1.5 1.5-1.5h3zm9-4.5c.828 0 1.5.672 1.5 1.5v15c0 .828-.672 1.5-1.5 1.5h-3c-.827 0-1.5-.672-1.5-1.5v-15c0-.828.673-1.5 1.5-1.5h3zm9 7.5c.828 0 1.5.672 1.5 1.5v7.5c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5V12c0-.828.672-1.5 1.5-1.5h3z"/></svg>}
                {s.id === 'leetcode' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"/></svg>}
                {s.id === 'strava' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>}
              </a>
            </li>
          ))}
        </ul>
        <div class="cta">
          <a class="btn" href={`${home}${profile.resume}`} target="_blank" rel="noopener">View resume</a>
          <div class="cta__mail">
            <span class="say-hi" aria-hidden="true">
              <svg class="pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l-1 6 3 3v2H7v-2l3-3-1-6Z" fill="var(--accent)" stroke="var(--accent)"/><path d="M12 14v7"/></svg>
              <span>say hi</span>
            </span>
            <a class="ulink" href={`mailto:${profile.email}`}>{profile.email}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="section reveal" id="experience" aria-labelledby="exp-h">
      <h2 class="section__h" id="exp-h">Experience</h2>
      <div class="exp">
      {experience.map((r) => {
        const lead = r.points.slice(0, r.lead);
        const more = r.points.slice(r.lead);
        return (
          <article class="role">
            <div class="role__meta">
              <h3 class="role__co">{r.company}</h3>
              {(r.site || r.linkedin) && (
                <p class="role__links">
                  {r.site && <a class="ulink" href={r.site} target="_blank" rel="noopener">Website <span class="arr" aria-hidden="true">↗</span></a>}
                  {r.linkedin && <a class="ulink" href={r.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arr" aria-hidden="true">↗</span></a>}
                </p>
              )}
              <ol class="tl">
                {r.titles.map((t) => (
                  <li class:list={['tl__item', { 'is-current': t.current }]}>
                    <span class="tl__title">{t.title}{t.note && <span class="tl__note"> · {t.note}</span>}</span>
                    <span class="tl__dates">{t.dates}</span>
                  </li>
                ))}
              </ol>
            </div>
            <div class="role__body">
              <ul class="points">
                {lead.map((p) => <li>{p}</li>)}
              </ul>
              {more.length > 0 && (
                <details class="more">
                  <summary class="btn btn--ghost"><span class="when-closed">Show more</span><span class="when-open">Show less</span></summary>
                  <ul class="points">
                    {more.map((p) => <li>{p}</li>)}
                  </ul>
                </details>
              )}
              <ul class="chips" aria-label="Technologies">
                {r.stack.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </article>
        );
      })}
      </div>
    </section>

    <!-- Projects -->
    <section class="section reveal" id="projects" aria-labelledby="proj-h">
      <h2 class="section__h" id="proj-h">Projects</h2>
      {projects.map((p) => {
        const Diagram = diagrams[p.id];
        return (
          <article class="project reveal">
            <div class="project__visual"><Diagram /></div>
            <div class="project__text">
              <h3 class="project__title">{p.name}</h3>
              <ul class="chips" aria-label="Technologies">{p.stack.map((t) => <li>{t}</li>)}</ul>
              <p class="project__desc">{p.desc}</p>
              <p class="project__links">
                <a class="ulink" href={p.repo} target="_blank" rel="noopener">GitHub repository <span aria-hidden="true">↗</span></a>
              </p>
            </div>
          </article>
        );
      })}

      <div class="earlier">
        <h3 class="sub-h">Earlier builds</h3>
        <ul>
          {earlierProjects.map((e) => (
            <li>
              <a class="ulink" href={e.href} target="_blank" rel="noopener">{e.name} <span aria-hidden="true">↗</span></a>
              <span class="muted"> — {e.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Writing -->
    <section class="section reveal" id="writing" aria-labelledby="blog-h">
      <h2 class="section__h" id="blog-h">Writing</h2>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a class="post" href={`${home}blog/${p.id}/`} target="_blank" rel="noopener">
              <span class="post__date mono">{fmt(p.data.date) ?? 'Undated'}</span>
              <span class="post__body">
                <span class="post__title">{p.data.title}</span>
                <span class="post__desc muted">{p.data.description}</span>
              </span>
              <span class="post__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Education & more -->
    <section class="section reveal" id="education" aria-labelledby="edu-h">
      <h2 class="section__h" id="edu-h">Education &amp; rankings</h2>
      <article class="role">
        <div class="role__meta">
          <h3 class="role__co">{education.school}</h3>
          <p class="muted small">{education.years}</p>
        </div>
        <div class="role__body">
          <p>{education.degree}</p>
          <p class="muted small">{education.detail} · {education.score}</p>
        </div>
      </article>
      <article class="role">
        <div class="role__meta">
          <h3 class="role__co">Competitive programming</h3>
          <p class="muted small">Max ratings</p>
        </div>
        <div class="role__body">
          <ul class="ratings">
            {ratings.map((r) => <li><span class="rating">{r.value}</span><span class="muted small">{r.site}</span></li>)}
          </ul>
          <ul class="points">
            {achievements.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </article>
    </section>

    <footer class="footer">
      <div class="footer__top">
        {quotes.length > 0 && (
          <figure class="quote" id="quote" data-quotes={JSON.stringify(quotes)}>
            <blockquote>{quotes[0].text}</blockquote>
            <figcaption>{quotes[0].author}</figcaption>
          </figure>
        )}
      </div>
      <p class="muted small">© <span id="year">2026</span> Jinang Vohera · Built with Astro, hosted on GitHub Pages.</p>
      <p><a class="ulink small" href="#" id="toTop">Back to top ↑</a></p>
    </footer>
  </main>
</Base>
