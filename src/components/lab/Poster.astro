---
// Thumbnail for an anime/series. If `image` is given it shows that picture in black and white;
// otherwise a paper tile with the title's initials in the site's 5x7 pixel font (same as the name).
interface Props { title: string; image?: string }
const { title, image } = Astro.props;

const FONT: Record<string, string[]> = {
  A: ['01110','10001','10001','11111','10001','10001','10001'], B: ['11110','10001','10001','11110','10001','10001','11110'],
  C: ['01111','10000','10000','10000','10000','10000','01111'], D: ['11110','10001','10001','10001','10001','10001','11110'],
  E: ['11111','10000','10000','11110','10000','10000','11111'], F: ['11111','10000','10000','11110','10000','10000','10000'],
  G: ['01111','10000','10000','10111','10001','10001','01111'], H: ['10001','10001','10001','11111','10001','10001','10001'],
  I: ['11111','00100','00100','00100','00100','00100','11111'], J: ['00111','00010','00010','00010','10010','10010','01100'],
  K: ['10001','10010','10100','11000','10100','10010','10001'], L: ['10000','10000','10000','10000','10000','10000','11111'],
  M: ['10001','11011','10101','10101','10001','10001','10001'], N: ['10001','11001','10101','10011','10001','10001','10001'],
  O: ['01110','10001','10001','10001','10001','10001','01110'], P: ['11110','10001','10001','11110','10000','10000','10000'],
  Q: ['01110','10001','10001','10001','10101','10010','01101'], R: ['11110','10001','10001','11110','10100','10010','10001'],
  S: ['01111','10000','10000','01110','00001','00001','11110'], T: ['11111','00100','00100','00100','00100','00100','00100'],
  U: ['10001','10001','10001','10001','10001','10001','01110'], V: ['10001','10001','10001','10001','10001','01010','00100'],
  W: ['10001','10001','10001','10101','10101','11011','10001'], X: ['10001','10001','01010','00100','01010','10001','10001'],
  Y: ['10001','10001','01010','00100','00100','00100','00100'], Z: ['11111','00001','00010','00100','01000','10000','11111'],
};

const initials = title.replace(/[^A-Za-z ]/g, '').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).filter((c) => FONT[c]);
const cell = 3.4, gap = 0.5, letterW = 5 * cell + 4 * gap, between = 3;
const totalW = initials.length * letterW + (initials.length - 1) * between;
const totalH = 7 * cell + 6 * gap;
const x0 = (60 - totalW) / 2, y0 = (84 - totalH) / 2;
const rects: { x: number; y: number }[] = [];
initials.forEach((ch, li) => {
  FONT[ch].forEach((row, r) => [...row].forEach((v, c) => {
    if (v === '1') rects.push({ x: x0 + li * (letterW + between) + c * (cell + gap), y: y0 + r * (cell + gap) });
  }));
});
---
{image ? (
  <img class="poster poster--img" src={image} alt="" loading="lazy" />
) : (
  <svg class="poster" viewBox="0 0 60 84" aria-hidden="true">
    <rect x="0.5" y="0.5" width="59" height="83" rx="2.5" fill="#f4f2ec" stroke="#d9d6cc"/>
    {rects.map((r) => <rect x={r.x} y={r.y} width={cell} height={cell} fill="#141414"/>)}
  </svg>
)}
